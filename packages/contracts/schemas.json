{
  "equipment": {
    "$defs": {
      "RadioProfile": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "frequency_mhz": {
            "maximum": 20000,
            "minimum": 30,
            "title": "Frequency Mhz",
            "type": "number"
          },
          "direction": {
            "enum": [
              "uplink",
              "downlink"
            ],
            "title": "Direction",
            "type": "string"
          },
          "role": {
            "enum": [
              "control",
              "video",
              "telemetry"
            ],
            "title": "Role",
            "type": "string"
          },
          "tx_dbm": {
            "anyOf": [
              {
                "maximum": 70,
                "minimum": -30,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Tx Dbm"
          },
          "sensitivity_dbm": {
            "anyOf": [
              {
                "maximum": 0,
                "minimum": -180,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sensitivity Dbm"
          },
          "tx_gain_dbi": {
            "default": 0,
            "maximum": 60,
            "minimum": -30,
            "title": "Tx Gain Dbi",
            "type": "number"
          },
          "rx_gain_dbi": {
            "default": 0,
            "maximum": 60,
            "minimum": -30,
            "title": "Rx Gain Dbi",
            "type": "number"
          },
          "cable_loss_db": {
            "default": 0,
            "maximum": 100,
            "minimum": 0,
            "title": "Cable Loss Db",
            "type": "number"
          },
          "additional_loss_db": {
            "default": 0,
            "maximum": 100,
            "minimum": 0,
            "title": "Additional Loss Db",
            "type": "number"
          },
          "polarization": {
            "default": "vertical",
            "enum": [
              "horizontal",
              "vertical"
            ],
            "title": "Polarization",
            "type": "string"
          },
          "provenance": {
            "default": "assumed",
            "enum": [
              "assumed",
              "manufacturer",
              "measured"
            ],
            "title": "Provenance",
            "type": "string"
          },
          "notes": {
            "default": "Proposed frequency; power and receiver threshold must be supplied. Gains are assumed.",
            "title": "Notes",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "frequency_mhz",
          "direction",
          "role"
        ],
        "title": "RadioProfile",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Portable assumptions. Original Field Kit values remain an immutable source snapshot.",
    "properties": {
      "schema": {
        "const": "prismo.equipment.v1",
        "title": "Schema",
        "type": "string"
      },
      "id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Id",
        "type": "string"
      },
      "revision": {
        "maximum": 1000000,
        "minimum": 1,
        "title": "Revision",
        "type": "integer"
      },
      "name": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Name",
        "type": "string"
      },
      "serial": {
        "default": "",
        "maxLength": 200,
        "title": "Serial",
        "type": "string"
      },
      "origin": {
        "enum": [
          "field-kit",
          "horizon"
        ],
        "title": "Origin",
        "type": "string"
      },
      "radios": {
        "items": {
          "$ref": "#/$defs/RadioProfile"
        },
        "maxItems": 20,
        "minItems": 1,
        "title": "Radios",
        "type": "array"
      },
      "margin_db": {
        "maximum": 60,
        "minimum": 0,
        "title": "Margin Db",
        "type": "number"
      },
      "source_profile": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Source Profile"
      }
    },
    "required": [
      "schema",
      "id",
      "revision",
      "name",
      "origin",
      "radios",
      "margin_db"
    ],
    "title": "Equipment",
    "type": "object"
  },
